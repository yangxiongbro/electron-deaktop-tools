{
  "name": "electron-deaktop-tools",
  "version": "1.1.3",
  "description": "跨平台桌面工具箱：JSON 格式化、命名规范转换、编码解码、API 请求、Markdown 编辑器",
  "main": "./out/main/index.js",
  "author": "electron-deaktop-tools",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && node scripts/electron-builder.mjs --dir",
    "build:win": "npm run build && node scripts/electron-builder.mjs --win --x64 --ia32 --arm64",
    "build:win:x64": "npm run build && node scripts/electron-builder.mjs --win --x64",
    "build:linux": "npm run build && node scripts/electron-builder.mjs --linux --x64 --arm64",
    "build:linux:armv7l": "npm run build && node scripts/electron-builder.mjs --linux --armv7l",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/crypto-js": "^4.2.2",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^5.0.5",
    "crypto-js": "^4.2.0",
    "electron": "^45.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "element-plus": "^2.7.8",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vue": "^3.4.31",
    "vue-tsc": "^2.0.26"
  }
}
